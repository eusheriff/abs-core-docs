{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "verifier_version",
    "verified_at_utc",
    "log_path",
    "log_sha256",
    "event_count",
    "first_sequence",
    "last_sequence",
    "last_event_hash",
    "registry_path",
    "registry_sha256",
    "registry_sig_valid",
    "genesis_valid",
    "chain_valid",
    "signatures_valid",
    "key_validity_valid",
    "result",
    "failures"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "verifier_version": { "type": "string" },
    "verified_at_utc": { "type": "string", "format": "date-time" },
    "log_path": { "type": "string" },
    "log_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "event_count": { "type": "integer", "minimum": 0 },
    "first_sequence": { "type": "integer", "minimum": 0 },
    "last_sequence": { "type": "integer", "minimum": 0 },
    "last_event_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "registry_path": { "type": "string" },
    "registry_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "registry_sig_valid": { "type": "boolean" },
    "genesis_valid": { "type": "boolean" },
    "chain_valid": { "type": "boolean" },
    "signatures_valid": { "type": "boolean" },
    "key_validity_valid": { "type": "boolean" },
    "result": { "type": "string", "enum": ["PASS", "FAIL"] },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "sequence", "event_id"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "sequence": { "type": "integer" },
          "event_id": { "type": "string" }
        }
      }
    }
  }
}
